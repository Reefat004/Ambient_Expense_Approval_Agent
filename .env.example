# Local Gemini API configuration. Copy to .env and supply your own key.
# .env is ignored by Git; this example contains no credentials.
GEMINI_API_KEY=

# Optional: select Vertex AI explicitly instead of Gemini API authentication.
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
